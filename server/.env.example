# Server
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API in production.
CLIENT_URL=https://admin.example.com,https://shop.example.com
# Optional origin used by builder product/content links. Blank means the current
# public origin in production; development defaults to http://localhost:3001.
BUILDER_STOREFRONT_ORIGIN=

# MySQL/MariaDB connection. Create a dedicated least-privilege production user.
DATABASE_URL="mysql://nix_user:replace-with-a-strong-password@127.0.0.1:3306/nix_order_management"

# Required in production. Generate a unique value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
DATA_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Required only when running the sample data seed.
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-password
