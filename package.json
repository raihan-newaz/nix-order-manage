{
  "name": "nix-order-manage-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint server/src/modules/builder client/src/builder server/src/scripts/installBuilder.ts",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "test:builder": "npm --prefix server run test:builder",
    "test:builder:e2e": "playwright test",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:storefront": "cd storefront && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build:storefront": "cd storefront && npm run build",
    "seed": "cd server && npm run prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
